# Square API Configuration
# Get your API keys from https://developer.squareup.com/apps

# Server-side only (keep secret!)
SQUARE_ACCESS_TOKEN=your_square_access_token_here
SQUARE_LOCATION_ID=your_square_location_id_here
SQUARE_WEBHOOK_SIGNATURE_KEY=your_webhook_signature_key_here

# Environment: 'sandbox' for testing, 'production' for live
SQUARE_ENVIRONMENT=sandbox

# Client-side (safe to expose)
NEXT_PUBLIC_SQUARE_APPLICATION_ID=sandbox-sq0idb-your_app_id_here
NEXT_PUBLIC_SQUARE_LOCATION_ID=your_square_location_id_here

# Database (if using Supabase or similar)
# DATABASE_URL=your_database_url_here
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
